<%- include("./partials/header.ejs") %> 

    <main class="main-content">
        
        <section class="books-section">
            <h2 class="section-title">
                <i class="bi bi-bookmarks-fill"></i>
                Books I Want to Read
            </h2>
            
            <% data.forEach((book) => { %>
                <div class="book-card">
                    <div class="book-info">
                        <h3 class="book-title">
                            <a href="/books/<%= book.id %>"><%= book.title %></a>
                        </h3>
                        <h4 class="book-author"><%= book.author %></h4>
                        <p class="book-description"><%= (book.description).slice(0, 120) + "..." %></p>
                    </div>

                    <div class="book-actions d-flex gap-2">
                        <form action="/books/<%= book.id %>/edit" method="GET" >
                            <button type="submit" class="btn edit-btn">
                                <i class="bi bi-pen"></i>
                                Edit
                            </button>
                        </form>
                        <form action="/books/<%= book.id %>/delete" method="POST" >
                            <button type="submit" class="btn remove-btn">
                                <i class="bi bi-trash"></i>
                                Remove
                            </button>
                        </form>
                    </div>

                    
                </div>
            <% }) %>
        </section>

        <section id="add" class="add-book-section">
            <h2 class="section-title">
                <i class="bi bi-plus-square-fill"></i>
                Add a New Book
            </h2>

            <form action="/books" method="POST">
                <div class="form-group">
                    <label>Title</label>
                    <input type="text" name="title" placeholder="Enter book title" />
                </div>
                <div class="form-group">
                    <label>Author</label>
                    <input type="text" name="author" placeholder="Enter author name" />
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea name="description" placeholder="Enter the book description"></textarea>
                </div>
                
                <button type="submit" class="add-book-btn">
                    <i class="bi bi-plus-lg"></i>
                    Add Book
                </button>
            </form>
        </section>

    </main>

<%- include("./partials/footer.ejs") %> 

